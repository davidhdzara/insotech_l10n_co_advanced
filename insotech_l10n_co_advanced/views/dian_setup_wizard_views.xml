<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- Wizard: Configuración Express DIAN — Form View                     -->
    <!-- ================================================================== -->
    <record id="insotech_l10n_co_advanced_dian_setup_wizard_form"
            model="ir.ui.view">
        <field name="name">insotech.dian.setup.wizard.form</field>
        <field name="model">insotech.dian.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Configuración Express DIAN">

                <!-- Hidden fields for visibility control -->
                <field name="current_step" invisible="1"/>
                <field name="config_state" invisible="1"/>

                <!-- ============================================= -->
                <!-- STEPPER HEADER — Visual step indicator         -->
                <!-- ============================================= -->
                <div class="o_wizard_step_container d-flex justify-content-center
                            align-items-center gap-3 py-3 border-bottom bg-view"
                     invisible="current_step == 'already_enabled'">

                    <!-- Step 1: Credentials -->
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-circle d-inline-flex
                                     align-items-center justify-content-center
                                     text-bg-primary"
                              style="width: 28px; height: 28px;"
                              invisible="current_step != 'credentials'">
                            <strong>1</strong>
                        </span>
                        <span class="badge rounded-circle d-inline-flex
                                     align-items-center justify-content-center
                                     text-bg-success"
                              style="width: 28px; height: 28px;"
                              invisible="current_step == 'credentials'">
                            <i class="fa fa-check"/>
                        </span>
                        <span class="fw-bold"
                              invisible="current_step != 'credentials'">
                            Credenciales
                        </span>
                        <span class="text-muted"
                              invisible="current_step == 'credentials'">
                            Credenciales
                        </span>
                    </div>

                    <i class="fa fa-chevron-right text-muted small"/>

                    <!-- Step 2: Confirm -->
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-circle d-inline-flex
                                     align-items-center justify-content-center
                                     text-bg-primary"
                              style="width: 28px; height: 28px;"
                              invisible="current_step != 'confirm'">
                            <strong>2</strong>
                        </span>
                        <span class="badge rounded-circle d-inline-flex
                                     align-items-center justify-content-center
                                     text-bg-success"
                              style="width: 28px; height: 28px;"
                              invisible="current_step not in ('done',)">
                            <i class="fa fa-check"/>
                        </span>
                        <span class="badge rounded-circle d-inline-flex
                                     align-items-center justify-content-center
                                     text-bg-secondary"
                              style="width: 28px; height: 28px;"
                              invisible="current_step in ('confirm', 'done')">
                            <strong>2</strong>
                        </span>
                        <span class="fw-bold"
                              invisible="current_step != 'confirm'">
                            Confirmación
                        </span>
                        <span class="text-muted"
                              invisible="current_step == 'confirm'">
                            Confirmación
                        </span>
                    </div>

                    <i class="fa fa-chevron-right text-muted small"/>

                    <!-- Step 3: Done -->
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-circle d-inline-flex
                                     align-items-center justify-content-center
                                     text-bg-primary"
                              style="width: 28px; height: 28px;"
                              invisible="current_step != 'done'">
                            <strong>3</strong>
                        </span>
                        <span class="badge rounded-circle d-inline-flex
                                     align-items-center justify-content-center
                                     text-bg-secondary"
                              style="width: 28px; height: 28px;"
                              invisible="current_step == 'done'">
                            <strong>3</strong>
                        </span>
                        <span class="fw-bold"
                              invisible="current_step != 'done'">
                            Resultado
                        </span>
                        <span class="text-muted"
                              invisible="current_step == 'done'">
                            Resultado
                        </span>
                    </div>
                </div>

                <!-- ============================================= -->
                <!-- STEP 1: Credentials                           -->
                <!-- ============================================= -->
                <div invisible="current_step != 'credentials'"
                     class="p-4">

                    <div class="alert alert-info mb-4" role="alert">
                        <i class="fa fa-info-circle"/>
                        <strong> Requisito previo:</strong>
                        Antes de continuar, asegúrese de haber cargado su
                        certificado digital (.p12) en
                        <em>Contabilidad → Configuración → Ajustes →
                        Facturación Electrónica</em>.
                    </div>

                    <group string="Credenciales DIAN" col="2">
                        <group>
                            <field name="company_id"
                                   readonly="1"
                                   options="{'no_create': True}"/>
                            <field name="software_id"
                                   placeholder="ej. a1b2c3d4-e5f6-7890-..."
                                   required="current_step == 'credentials'"/>
                            <field name="software_pin"
                                   password="True"
                                   placeholder="ej. 12345"
                                   required="current_step == 'credentials'"/>
                        </group>
                        <group>
                            <field name="test_set_id"
                                   placeholder="ej. abc123def456..."
                                   required="current_step == 'credentials'"/>
                            <field name="enable_support_documents"
                                   help="Active si necesita emitir Documentos
                                         Soporte electrónicos para compras a
                                         no obligados a facturar."/>
                        </group>
                    </group>

                    <div class="text-muted small mt-3">
                        <i class="fa fa-question-circle"/>
                        Estos datos se obtienen del portal de habilitación
                        DIAN en
                        <strong>Configuración → Software Propio</strong>
                        y <strong>Asociar Rangos de Prueba</strong>.
                    </div>
                </div>

                <!-- ============================================= -->
                <!-- STEP 2: Confirmation                          -->
                <!-- ============================================= -->
                <div invisible="current_step != 'confirm'"
                     class="p-4">

                    <h3 class="mb-4">
                        <i class="fa fa-check-circle text-success"/>
                        Resumen de Configuración
                    </h3>

                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="row mb-2">
                                <div class="col-4 text-muted">
                                    <i class="fa fa-building me-1"/>
                                    Empresa
                                </div>
                                <div class="col-8 fw-bold">
                                    <field name="company_id"
                                           readonly="1"
                                           nolabel="1"
                                           options="{'no_open': True}"/>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-4 text-muted">
                                    <i class="fa fa-key me-1"/>
                                    Software ID
                                </div>
                                <div class="col-8">
                                    <field name="software_id"
                                           readonly="1"
                                           nolabel="1"/>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-4 text-muted">
                                    <i class="fa fa-lock me-1"/>
                                    PIN de Software
                                </div>
                                <div class="col-8">
                                    <span>••••••</span>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-4 text-muted">
                                    <i class="fa fa-flask me-1"/>
                                    Test Set ID
                                </div>
                                <div class="col-8">
                                    <field name="test_set_id"
                                           readonly="1"
                                           nolabel="1"/>
                                </div>
                            </div>
                            <div class="row"
                                 invisible="not enable_support_documents">
                                <div class="col-4 text-muted">
                                    <i class="fa fa-file-text-o me-1"/>
                                    Documentos Soporte
                                </div>
                                <div class="col-8">
                                    <span class="badge text-bg-success">
                                        <i class="fa fa-check"/> Incluido
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning" role="alert">
                        <i class="fa fa-exclamation-triangle"/>
                        <strong> Al confirmar, se realizarán las
                        siguientes acciones:</strong>
                        <ul class="mt-2 mb-0">
                            <li>Configuración de los Modos de Operación
                                DIAN con sus credenciales.</li>
                            <li>Activación del entorno de pruebas.</li>
                            <li>Inicio del proceso de certificación
                                (set de pruebas DIAN).</li>
                        </ul>
                    </div>
                </div>

                <!-- ============================================= -->
                <!-- STEP 3: Done / Result                         -->
                <!-- ============================================= -->
                <div invisible="current_step != 'done'"
                     class="p-4">
                    <field name="result_message"
                           nolabel="1"
                           readonly="1"/>
                </div>

                <!-- ============================================= -->
                <!-- ALREADY ENABLED state                         -->
                <!-- ============================================= -->
                <div invisible="current_step != 'already_enabled'"
                     class="p-4">

                    <div class="alert alert-success" role="alert">
                        <h4 class="alert-heading mb-2">
                            <i class="fa fa-check-circle"/>
                            Facturación Electrónica Habilitada
                        </h4>
                        <p>
                            Su facturación electrónica está habilitada y
                            configurada. No se requieren cambios adicionales.
                        </p>
                        <hr/>
                        <p class="mb-0 small text-muted">
                            Si necesita modificar la configuración, utilice
                            el botón "Desbloquear" a continuación. Esta acción
                            solo está disponible para administradores contables.
                        </p>
                    </div>

                    <div class="text-center"
                         groups="account.group_account_manager">
                        <button name="%(insotech_l10n_co_advanced.insotech_l10n_co_advanced_action_unlock_dian_config)d"
                                string="🔓 Desbloquear Configuración"
                                type="action"
                                class="btn-secondary"
                                confirm="¿Está seguro? Desbloquear la configuración podría afectar su facturación electrónica."/>
                    </div>
                </div>

                <!-- ============================================= -->
                <!-- FOOTER — Navigation buttons                   -->
                <!-- ============================================= -->
                <footer>
                    <!-- Step 1 footer -->
                    <button name="action_apply_credentials"
                            string="Siguiente"
                            type="object"
                            class="btn-primary"
                            icon="fa-arrow-right"
                            invisible="current_step != 'credentials'"/>

                    <!-- Step 2 footer -->
                    <button name="action_prev_step"
                            string="Anterior"
                            type="object"
                            class="btn-secondary"
                            icon="fa-arrow-left"
                            invisible="current_step != 'confirm'"/>
                    <button name="action_start_certification"
                            string="Iniciar Certificación"
                            type="object"
                            class="btn-primary"
                            icon="fa-rocket"
                            invisible="current_step != 'confirm'"
                            confirm="¿Desea iniciar el proceso de certificación? Se configurarán los modos de operación y se activará el entorno de pruebas."/>

                    <!-- Step 3 footer (done) -->
                    <button string="Cerrar"
                            class="btn-primary"
                            special="cancel"
                            invisible="current_step not in ('done', 'already_enabled')"/>

                    <!-- Cancel on steps 1-2 -->
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"
                            invisible="current_step not in ('credentials', 'confirm')"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Action: Open the DIAN Setup Wizard                                 -->
    <!-- ================================================================== -->
    <record id="insotech_l10n_co_advanced_action_dian_setup_wizard"
            model="ir.actions.act_window">
        <field name="name">Configuración Express DIAN</field>
        <field name="res_model">insotech.dian.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ================================================================== -->
    <!-- Action: Unlock DIAN config (called from wizard)                    -->
    <!-- ================================================================== -->
    <record id="insotech_l10n_co_advanced_action_unlock_dian_config"
            model="ir.actions.server">
        <field name="name">Desbloquear Config. DIAN</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">
company = env.company
company.action_insotech_unlock_dian_config()
action = {
    'type': 'ir.actions.act_window',
    'res_model': 'insotech.dian.setup.wizard',
    'view_mode': 'form',
    'target': 'new',
}
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Menu: Contabilidad → Configuración → Configuración Express DIAN    -->
    <!-- ================================================================== -->
    <menuitem id="insotech_l10n_co_advanced_menu_dian_setup"
              name="Configuración Express DIAN"
              parent="account.account_account_menu"
              action="insotech_l10n_co_advanced_action_dian_setup_wizard"
              groups="account.group_account_manager"
              sequence="99"/>

</odoo>
