<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        RADIAN PDF Complement — Título Valor (Resolución DIAN 000165)
        Filosofía: Solo COMPLEMENTAR lo que Odoo + l10n_co_dian NO proveen.
        NO se oculta ni reemplaza ningún nodo nativo.
    -->
    <template id="report_invoice_document_inherit_radian" inherit_id="account.report_invoice_document">

        <!-- ============================================================
             A. COMPLEMENTO AL BLOQUE DE CLIENTE
             El nativo muestra nombre, dirección y NIT.
             Nosotros añadimos: label legal + teléfono + email.
             ============================================================ -->
        <xpath expr="//div[@name='no_shipping']" position="after">
            <div class="mt-2" style="font-size: 0.9em;">
                <div class="text-uppercase fw-bold text-muted mb-1" style="font-size: 0.8em; letter-spacing: 0.05em;">Adquiriente / Deudor</div>
                <div t-if="o.partner_id.phone">
                    <strong>Teléfono:</strong> <span t-field="o.partner_id.phone"/>
                </div>
                <div t-if="o.partner_id.email">
                    <strong>Correo:</strong> <span t-field="o.partner_id.email"/>
                </div>
            </div>
        </xpath>

        <!-- ============================================================
             B. COMPLEMENTO AL BLOQUE DE INFORMACIÓN
             El nativo ya tiene: fecha, vencimiento, origen, ref.
             Nosotros añadimos: Forma de pago y Método de pago.
             ============================================================ -->
        <xpath expr="//div[@id='informations']" position="inside">
            <div class="col-auto" t-if="o.l10n_co_edi_payment_option_id" name="payment_method">
                <strong>Método de pago:</strong>
                <p class="m-0" t-field="o.l10n_co_edi_payment_option_id"/>
            </div>
            <div class="col-auto" name="payment_form">
                <strong>Forma de pago:</strong>
                <p class="m-0">
                    <t t-if="o.l10n_co_edi_is_direct_payment">Contado</t>
                    <t t-else="">Crédito</t>
                </p>
            </div>
        </xpath>

        <!-- ============================================================
             C. VALOR EN LETRAS + RECAUDO BANCARIO
             Se inyecta DESPUÉS de los totales, antes de payment_term.
             ============================================================ -->
        <xpath expr="//div[@id='total']" position="after">
            <div class="row mt-3 mb-3">
                <div class="col-12">
                    <p class="mb-1"><strong>Monto Total en Letras (Código de Comercio Art. 621):</strong></p>
                    <p class="fw-bold mb-2">
                        <span t-esc="o.amount_to_words or ''"/>
                    </p>
                </div>
            </div>
            <div class="row mb-3" t-if="o.journal_id.bank_account_id">
                <div class="col-12">
                    <strong>Referencia de pago:</strong> <span t-field="o.payment_reference"/><br/>
                    en esta cuenta: <strong><span t-esc="o.journal_id.bank_account_id.display_name"/></strong>
                </div>
            </div>
        </xpath>

        <!-- ============================================================
             D. CONTENIDO LEGAL TÍTULO VALOR (FOOTER)
             Se inyecta DESPUÉS de payment_term. No toca #qrcode.
             El QR y la resolución ya los maneja l10n_co_dian nativo.
             Aquí solo complementamos: Método pago, Valor letras,
             CUFE, Firma, Resolución+Rango, y texto legal.
             ============================================================ -->
        <xpath expr="//div[@id='payment_term']" position="after">
            <div class="mt-4 pt-3 border-top" style="font-size: 0.85em; line-height: 1.6;" id="titulo_valor_footer">

                <!-- Método de pago (redundancia legal para footer) -->
                <p class="mb-1" t-if="o.l10n_co_edi_payment_option_id">
                    <strong>Método de pago:</strong> <span t-field="o.l10n_co_edi_payment_option_id"/>
                </p>

                <!-- Valor en letras (redundancia legal) -->
                <p class="mb-1">
                    <strong>Valor en letras:</strong>
                    <span t-esc="o.amount_to_words or ''"/>
                </p>

                <!-- CUFE / CUDE -->
                <p class="mb-1" t-if="o.l10n_co_edi_cufe_cude_ref">
                    <strong>CUFE:</strong>
                    <span t-esc="o.l10n_co_edi_cufe_cude_ref" style="word-break: break-all;"/>
                </p>

                <!-- Firma Digital (extraída del XML firmado) -->
                <t t-set="signature_value" t-value="o._get_dian_signature_value()"/>
                <p class="mb-1" t-if="signature_value">
                    <strong>Firma:</strong>
                    <span t-esc="signature_value" style="word-break: break-all;"/>
                </p>

                <!-- Resolución + Rango (complemento textual) -->
                <p class="mb-1" t-if="o.journal_id.l10n_co_edi_dian_authorization_number">
                    <strong>Número de autorización de facturación:</strong>
                    <span t-field="o.journal_id.l10n_co_edi_dian_authorization_number"/>
                    Fecha: <span t-field="o.journal_id.l10n_co_edi_dian_authorization_date"/>
                </p>
                <p class="mb-1" t-if="o.journal_id.l10n_co_edi_min_range_number">
                    <strong>Rango autorizado desde:</strong>
                    <span t-esc="o.sequence_prefix"/> <span t-field="o.journal_id.l10n_co_edi_min_range_number"/>
                    a <span t-esc="o.sequence_prefix"/> <span t-field="o.journal_id.l10n_co_edi_max_range_number"/>
                    Válido desde: <span t-field="o.journal_id.l10n_co_edi_dian_authorization_date"/>
                    a <span t-field="o.journal_id.l10n_co_edi_dian_authorization_end_date"/>
                </p>

                <!-- Texto legal obligatorio -->
                <p class="mt-2 text-muted text-center" style="font-size: 0.85em;">
                    Representación gráfica de facturación electrónica impresa por computador con software propio por
                    <span t-field="o.company_id.name"/>
                </p>
            </div>
        </xpath>

    </template>
</odoo>
