<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add DV field next to VAT in partner form -->
    <record id="view_partner_form_insotech_dv" model="ir.ui.view">
        <field name="name">res.partner.form.insotech.dv</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <field name="insotech_dv"
                       string="DV"
                       class="oe_inline"
                       invisible="not vat"/>
            </field>
        </field>
    </record>
</odoo>
