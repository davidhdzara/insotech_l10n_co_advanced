<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_radian_actions" name="Acciones RADIAN">
        <t t-if="invoice.insotech_dian_status == 'accepted'">
            <style type="text/css">
                .insotech-radian-btn {
                    transition: all 0.2s ease;
                }
                .insotech-radian-btn:hover {
                    filter: brightness(1.1);
                    transform: translateY(-2px);
                }
                .insotech-mandate-bg {
                    background-color: #f8f9fa;
                    border: 1px solid #e9ecef;
                }
                .insotech-bg-primary {
                    background-color: #003498 !important;
                    border-color: #003498 !important;
                    color: white !important;
                }
            </style>
            <!-- Compute events natively from recordset -->
            <t t-set="events" t-value="invoice.env['insotech.radian.event'].sudo().search([('move_id', '=', invoice.id), ('state', '!=', 'error')]).mapped('event_code')"/>
            
            <!-- Hide entire block if already endosada, because actions are handled by the bank now -->
            <t t-if="'037' not in events and '038' not in events and '039' not in events">
                <div class="d-flex flex-column gap-3 mt-4 insotech-mandate-bg p-3 rounded-4 shadow-sm position-relative">
                    <h5 class="mb-3 text-center text-dark fw-bold">
                        <i class="fa fa-handshake-o text-muted"/> Título Valor (RADIAN)
                    </h5>
                    <form id="radian_form" method="post" class="w-100">
                        <!-- Cross-Site Request Forgery Protection -->
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="access_token" t-att-value="invoice._context.get('access_token') or request.params.get('access_token')"/>

                        <!-- CHECKBOX DE MANDATO -->
                        <div class="form-check mb-3 p-3 bg-white rounded-3 shadow-sm border d-flex align-items-center">
                            <input class="form-check-input flex-shrink-0 mt-0" type="checkbox" id="radian_mandate" name="radian_mandate" required="required" style="width: 1.2rem; height: 1.2rem; cursor: pointer;"/>
                            <label class="form-check-label small ms-3 text-muted" for="radian_mandate" style="cursor: pointer;">
                                Autorizo expresamente a <strong class="text-dark" t-esc="invoice.company_id.name"/> a generar y firmar electrónicamente los eventos RADIAN ante la DIAN en mi nombre y representación.
                            </label>
                        </div>

                        <div class="d-grid gap-2">
                            <!-- Botón 030 -->
                            <t t-if="not events">
                                <button type="submit" formaction="?radian_action=030" onclick="this.form.action='/my/invoices/' + parseInt(this.form.elements['invoice_id'] || 0) + '/radian/030';" class="btn insotech-bg-primary insotech-radian-btn fw-bold w-100 py-2">
                                    <i class="fa fa-envelope-open-o me-1"/> Acuse de Recibo (030)
                                </button>
                            </t>

                            <!-- Botón 032 -->
                            <t t-if="'030' in events and '032' not in events">
                                <div class="alert alert-success p-2 mb-2 text-center small"><i class="fa fa-check"/> Acuse de Recibo emitido.</div>
                                <button type="submit" formaction="?radian_action=032" onclick="this.form.action='/my/invoices/' + parseInt(this.form.elements['invoice_id'] || 0) + '/radian/032';" class="btn btn-info text-white insotech-radian-btn fw-bold w-100 py-2">
                                    <i class="fa fa-box-open me-1"/> Recibir Bien/Servicio (032)
                                </button>
                            </t>

                            <!-- Botones 033 / 034 / 031 -->
                            <t t-if="'032' in events and '033' not in events and '034' not in events and '031' not in events">
                                <div class="alert alert-success p-2 mb-2 text-center small"><i class="fa fa-check"/> Bien/Servicio recibido.</div>
                                <button type="submit" formaction="?radian_action=033" onclick="this.form.action='/my/invoices/' + parseInt(this.form.elements['invoice_id'] || 0) + '/radian/033';" class="btn btn-success insotech-radian-btn fw-bold w-100 mb-2 py-2">
                                    <i class="fa fa-thumbs-up me-1"/> Aceptación Expresa (033)
                                </button>
                                
                                <div class="input-group mb-2">
                                    <select name="claim_code" class="form-select" aria-label="Motivo de Reclamo" style="font-size: 0.85rem;">
                                        <option value="01">01 - Doc. con inconsistencias</option>
                                        <option value="02">02 - Mercancía no entregada total</option>
                                        <option value="03">03 - Mercancía no entregada parcial</option>
                                        <option value="04">04 - Servicio no prestado</option>
                                    </select>
                                    <button type="submit" formaction="?radian_action=034" onclick="this.form.action='/my/invoices/' + parseInt(this.form.elements['invoice_id'] || 0) + '/radian/034';" class="btn btn-outline-warning text-dark shadow-none insotech-radian-btn fw-bold">
                                        <i class="fa fa-hand-paper-o"/> Reclamo
                                    </button>
                                </div>
                                <button type="submit" formaction="?radian_action=031" onclick="this.form.action='/my/invoices/' + parseInt(this.form.elements['invoice_id'] || 0) + '/radian/031';" class="btn btn-outline-danger insotech-radian-btn fw-bold w-100 py-2">
                                    <i class="fa fa-times-circle me-1"/> Rechazo Total (031)
                                </button>
                            </t>
                            
                            <t t-if="'033' in events or '035' in events">
                                <div class="alert alert-success mb-0 text-center small fw-bold mt-2">
                                    <i class="fa fa-certificate"/> Constituida como Título Valor
                                </div>
                            </t>
                            
                            <t t-if="'031' in events">
                                <div class="alert alert-danger mb-0 text-center small fw-bold mt-2">
                                    <i class="fa fa-times"/> Documento Rechazado (031)
                                </div>
                            </t>
                            <t t-if="'034' in events">
                                <div class="alert alert-warning mb-0 text-center small fw-bold mt-2">
                                    <i class="fa fa-warning"/> En Reclamo (034)
                                </div>
                            </t>

                            <!-- Hack to pass invoice.id easily to JS since 'formaction' doesn't always eval in older webkits if we override JS -->
                            <input type="hidden" name="invoice_id" t-att-value="invoice.id"/>
                        </div>
                    </form>
                    
                    <script type="text/javascript">
                        document.addEventListener("DOMContentLoaded", function () {
                            var radianForm = document.getElementById("radian_form");
                            if(radianForm) {
                                radianForm.addEventListener("submit", function (e) {
                                    var checkbox = document.getElementById("radian_mandate");
                                    if (!checkbox.checked) {
                                        e.preventDefault();
                                        alert("Debe autorizar explícitamente a la empresa marcando la casilla del Mandato Legal para continuar.");
                                        return;
                                    }
                                    // Add a small delay spinner effect to button
                                    var btn = e.submitter;
                                    if(btn) {
                                        btn.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i> Procesando...';
                                        btn.classList.add('disabled');
                                    }
                                });
                            }
                        });
                    </script>
                </div>
            </t>
        </t>
    </template>
</odoo>
