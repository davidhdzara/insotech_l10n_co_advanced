<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_radian_traceability" name="Trazabilidad Legal DIAN">
        <t t-if="invoice.insotech_dian_status == 'accepted'">
            <!-- PDF Footer Replica -->
            <div class="row w-100 mt-2" style="font-size: 0.85rem; color: #000; font-family: sans-serif;">
                <div class="col-12 col-md-3 text-center mb-3 mb-md-0 pt-2">
                    <!-- Real QR Code -->
                    <t t-set="qr_string" t-value="invoice.l10n_co_edi_qr_code if 'l10n_co_edi_qr_code' in invoice and invoice.l10n_co_edi_qr_code else 'https://catalogo-vpfe.dian.gov.co/document/searchqr?documentkey=' + (invoice.l10n_co_edi_cufe_cude_ref or '')"/>
                    <img t-attf-src="/report/barcode/?barcode_type=QR&amp;value={{ qr_string }}&amp;width=180&amp;height=180" class="img-fluid border p-1" alt="QR DIAN"/>
                </div>
                <div class="col-12 col-md-9 text-start">
                    <div><strong>DIAN Resolución</strong> <span t-esc="invoice.journal_id.l10n_co_edi_dian_authorization_number or 'N/A'"/></div>
                    <div><strong>Fecha efectiva desde</strong> <span t-esc="invoice.journal_id.l10n_co_edi_dian_authorization_date or ''"/> <strong>a</strong> <span t-esc="invoice.journal_id.l10n_co_edi_dian_authorization_end_date or ''"/></div>
                    <div><strong>Número de secuencia desde</strong> <span t-esc="invoice.journal_id.l10n_co_edi_min_range_number or ''"/> <strong>a</strong> <span t-esc="invoice.journal_id.l10n_co_edi_max_range_number or ''"/></div>
                    
                    <t t-set="partner_fiscal" t-value="invoice.company_id.partner_id"/>
                    <t t-if="partner_fiscal">
                        <div><strong>Régimen fiscal:</strong> <span t-esc="'Responsable de IVA' if partner_fiscal.l10n_co_edi_obligation_type_ids else 'No Responsable'"/></div>
                        <div><strong>Responsabilidad tributaria:</strong> <span t-esc="', '.join(partner_fiscal.l10n_co_edi_obligation_type_ids.mapped('name')) if partner_fiscal.l10n_co_edi_obligation_type_ids else 'Ninguna'"/></div>
                    </t>
                    
                    <div style="word-break: break-all;"><strong>CUFE:</strong> <span t-esc="invoice.l10n_co_edi_cufe_cude_ref or ''"/></div>
                    <div><strong>Fecha de emisión:</strong> <span t-esc="invoice.invoice_date"/> <span t-esc="invoice.create_date.strftime('%H:%M:%S') if invoice.create_date else ''"/></div>
                    <div><strong>Generado por:</strong> InSoTech L10n CO</div>
                    <div><strong>NIT:</strong> <span t-esc="invoice.company_id.vat"/></div>
                </div>
            </div>
        </t>
    </template>
</odoo>
