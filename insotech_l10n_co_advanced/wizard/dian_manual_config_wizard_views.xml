<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dian_manual_config_wizard_form" model="ir.ui.view">
        <field name="name">l10n_co_dian.manual.config.wizard.form</field>
        <field name="model">l10n_co_dian.manual.config.wizard</field>
        <field name="arch" type="xml">
            <form string="Configurar Resolución DIAN Manualmente">
                <group>
                    <div class="alert alert-info" role="alert" colspan="2">
                        <strong>ℹ️ Configuración Manual</strong>
                        <p>Ingrese los datos de la resolución DIAN tal como aparecen en el portal MUISCA
                        y en la sección "Facturando Electrónicamente" del portal de la DIAN.</p>
                    </div>
                </group>
                <group>
                    <group string="Resolución">
                        <field name="journal_id" invisible="1"/>
                        <field name="authorization_number"
                               placeholder="Ej: 18764107498052"
                               required="1"/>
                        <field name="authorization_date" required="1"/>
                        <field name="authorization_end_date" required="1"/>
                    </group>
                    <group string="Rango de Numeración">
                        <field name="min_range_number" required="1"/>
                        <field name="max_range_number" required="1"/>
                        <field name="technical_key"
                               placeholder="Si no la tiene, déjela vacía"/>
                    </group>
                </group>
                <footer>
                    <button name="action_save_config"
                            string="Guardar Configuración"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
